{
  "name": "ladder",
  "version": "0.1.0",
  "description": "CLI RSS reader — fastladder のオマージュ",
  "type": "module",
  "bin": {
    "ladder": "./bin/ladder.cjs"
  },
  "scripts": {
    "dev": "tsx bin/ladder.ts",
    "dev:server": "tsx watch bin/ladder.ts serve",
    "dev:client": "vite",
    "build": "npm run build:web && esbuild bin/ladder.ts --bundle --platform=node --format=cjs --outfile=bin/ladder.cjs --external:better-sqlite3 --external:neo-blessed",
    "build:web": "vite build",
    "start": "node bin/ladder.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^9.0.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.0.0",
    "hono": "^4.12.19",
    "html-to-text": "^9.0.0",
    "isomorphic-dompurify": "^3.13.0",
    "neo-blessed": "^0.2.0",
    "node-fetch": "^3.3.0",
    "pinia": "^3.0.4",
    "rss-parser": "^3.13.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/html-to-text": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "esbuild": "^0.27.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.9"
  }
}
